# Copier ce fichier en .env (PowerShell : copy .env.example .env) puis choisir un mot de passe.
# Le fichier .env n'est jamais envoyé sur GitHub.

# Base PostgreSQL locale lancée par docker-compose.yml
POSTGRES_USER=coachplan
POSTGRES_PASSWORD=choisir-un-mot-de-passe
POSTGRES_DB=coachplan

# Adresse de connexion utilisée par Express (même mot de passe que ci-dessus)
DATABASE_URL=postgres://coachplan:choisir-un-mot-de-passe@localhost:5432/coachplan

# Optionnel : secret de signature des jetons de connexion.
# S'il est absent, un secret aléatoire est généré et stocké dans la table app_settings.
# JWT_SECRET=
